# 31337 = local anvil, 10143 = Monad testnet, 143 = Monad mainnet
NEXT_PUBLIC_CHAIN_ID=31337
# Server key: scorer + relayer (pays users' gas). Local: anvil key 0. Never commit a real one.
SERVER_PRIVATE_KEY=
ADMIN_SECRET=local
# Required on Monad (public RPC caps eth_getLogs at 100 blocks): https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Optional: payer labels + related wallets
NANSEN_API_KEY=
# Optional: any-chain deposits (https://studio.aurora.dev)
NEXT_PUBLIC_AURORA_API_KEY=
